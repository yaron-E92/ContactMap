<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ContactMap.Presentation.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ContactMap.Presentation.Maui.Views">
    <TabBar>
        <Tab Title="People">
            <ShellContent ContentTemplate="{DataTemplate views:PeoplePage}" />
        </Tab>
        <Tab Title="Map">
            <ShellContent ContentTemplate="{DataTemplate views:MainMapPage}" />
        </Tab>
    </TabBar>
</Shell>