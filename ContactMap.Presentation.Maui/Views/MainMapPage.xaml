<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ContactMap.Presentation.Maui.Views.MainMapPage"
             xmlns:viewmodels="clr-namespace:ContactMap.Presentation.Maui.ViewModels"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             xmlns:entities="clr-namespace:ContactMap.Domain.Entities;assembly=ContactMap.Domain"
             x:DataType="viewmodels:MainMapViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <SearchBar Grid.Row="0" x:Name="SearchBar" Placeholder="Search people or community..." />
        <maps:Map Grid.Row="1" x:Name="PeopleMap" />
        <ListView Grid.Row="2" x:Name="PeopleListView">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="entities:Person">
                    <TextCell Text="{Binding Name}" Detail="{Binding Address.City}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentPage>
